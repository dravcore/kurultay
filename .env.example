# Credentials docker-compose.yml / docker-compose.dev.yml hand to the `postgres` container —
# compose-only, no application code reads these three directly (the app only ever sees the
# assembled DATABASE_URL below). POSTGRES_USER/POSTGRES_DB have safe defaults and are listed
# here only so they're discoverable; POSTGRES_PASSWORD does not, same as BETTER_AUTH_SECRET
# further down — see docs/development.md#database-and-cache-credentials.
POSTGRES_USER=kurul
# Required, no default: compose refuses to start until this is set (`docker compose config`/
# `up` fails loudly), so a known password never ships in a real deployment. Copy it into the
# DATABASE_URL password segment below too — compose does not derive one from the other.
# Changing this on an *existing* postgres_data volume does **not** rotate the running
# database's password; see the [Unreleased] entry in CHANGELOG.md for the `ALTER USER`
# fix-up.
#
# Unlike BETTER_AUTH_SECRET below, this value is embedded directly in a connection URL
# (DATABASE_URL), not just compared byte-for-byte — so `openssl rand -base64 32` is the
# wrong generator: its alphabet includes `/` and `+`, and a `/` in the password ends the
# URL's authority section right there (roughly half of all base64-32 outputs contain one).
# Generate it with `openssl rand -hex 32` instead — alphabet `0-9a-f`, always URL-safe.
POSTGRES_PASSWORD=
POSTGRES_DB=kurul
# Optional: unset keeps the `redis` container passwordless, exactly as it behaved before this
# variable existed — no existing deployment breaks by leaving it blank. Set it to also apply
# `--requirepass` to `redis` and carry the password in the REDIS_URL docker-compose.yml builds
# for `api`; the host-side REDIS_URL below is unaffected, since docker-compose.dev.yml's redis
# has no password by default either. Same constraint as POSTGRES_PASSWORD above, and the same
# fix: this also lands in a connection URL (REDIS_URL), so generate it with
# `openssl rand -hex 32`, not `-base64`.
REDIS_PASSWORD=

# Host-side connection strings for the dev loop (docs/development.md#run-modes): `pnpm dev`
# runs api/web on the host and reaches Postgres/Redis at localhost, through the ports
# docker-compose.dev.yml publishes. This is a *separate* string from the one
# docker-compose.yml assembles for its own containers (those talk to `postgres`/`redis` over
# the compose network, never localhost) — fill in the same password you set for
# POSTGRES_PASSWORD above; compose does not keep the two in sync automatically.
DATABASE_URL=postgresql://kurul:<POSTGRES_PASSWORD>@localhost:5432/kurul
# Three knobs on the `pg` pool `apps/api/src/prisma/database.ts` shares between PrismaService
# and Better Auth. All optional — the defaults below are what the app already uses if you
# leave them unset, chosen to be generous enough that normal traffic never trips them while
# still turning "pool exhausted" or "query stuck" into a diagnosable error instead of a hang.
# See docs/development.md#environment-variables.
#
# Max simultaneous connections this instance opens to Postgres. Raise it alongside Postgres's
# own `max_connections` if one API instance is consistently queuing under normal load; an
# unbounded pool just moves the exhaustion from "this app" to "every app sharing the database".
DATABASE_POOL_MAX=20
# How long a request waits for a connection to free up (or a new one to finish opening) before
# failing, once all DATABASE_POOL_MAX connections are busy. `pg`'s own default is 0 — no
# timeout, i.e. wait forever — which turns a saturated pool into requests that never resolve
# instead of a clear error.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# How long a single SQL statement may run before Postgres kills it. Applied per connection this
# pool opens (`pg` sends it as a startup parameter, not a query), so it does not reach
# `prisma migrate deploy`/`dev` (a separate process against `DATABASE_URL` directly) or
# `pnpm db:seed`'s own bulk deletes/inserts (a separate `Pool` it opens itself) — only queries
# made through this shared pool are bounded by it. Without it, one runaway query holds a
# connection (and one of the DATABASE_POOL_MAX slots) indefinitely.
DATABASE_STATEMENT_TIMEOUT_MS=30000
# A database index is honoured: redis://localhost:6379/3 keeps this instance's keys (auth
# rate-limit counters, the due-soon and cleanup queues) on index 3, which is how several apps
# share one Redis. Pub/sub is not scoped by index, so the Socket.io fan-out channel is still
# shared; see docs/development.md#database-and-cache-credentials.
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
# Public URL of the API (Better Auth is mounted on Nest at /auth/*).
BETTER_AUTH_URL=http://localhost:4000
API_PORT=4000
WEB_URL=http://localhost:3000
# The interactive API console at /docs and the OpenAPI document at /openapi.json.
#
# Unset, this follows NODE_ENV: on in development, **off in production**. That default is the
# decision. The document leaks little — Kurul is AGPL and the routes are on GitHub — but
# /docs is an unauthenticated HTML page on a service that otherwise renders none (it needs its
# own Content-Security-Policy exception), and its "Try it out" console issues real requests
# with the reader's own session cookie attached. Handing that to an operator who did not ask
# for it is worth a deliberate `true` rather than a default nobody chose.
#
# Turning it off costs nothing in discoverability: the identical document is committed at
# apps/api/openapi.json and CI fails when it drifts, so the contract is readable without a
# running server. See docs/api-conventions.md#the-openapi-document.
API_DOCS_ENABLED=
# Rate limiting, on unless this says otherwise. Only the integration suite turns it off (it
# drives hundreds of requests per route from one address); switching it off in a deployment
# removes the API's brute-force ceiling. See docs/api-conventions.md#rate-limiting.
RATE_LIMIT_ENABLED=true
# Off by default — the API trusts nothing about where a request came from beyond the raw TCP
# connection, which is correct and safe for a directly-exposed instance. Behind a reverse proxy
# (Caddy/Traefik terminating TLS in front of the app), leaving this off makes every request look
# like it came from the proxy: every rate-limit bucket and the access log's `ip` field collapse
# onto one address. Set it to the number of proxy hops in front of the app (usually just "1"),
# or to the proxy's own IP/CIDR if more than one process could sit at that hop. Both apply to
# `/workspaces/*`-style routes (Nest's `req.ip`) and `/auth/*` (Better Auth, configured
# separately — see docs/api-conventions.md#rate-limiting) from the same value.
# NEVER set this to `true` unless the API process is genuinely unreachable except through the
# proxy (e.g. its port is not published outside a Docker network only the proxy can reach): it
# trusts the entire X-Forwarded-For chain a client sends with no verification at all, so on a
# directly-exposed instance any attacker can fabricate the header and hand themselves an
# unlimited rate-limit budget — exactly the ceiling this variable exists to protect.
TRUST_PROXY=false
# Largest JSON or form-encoded request body the API will read, in bytes. 1048576 = 1 MiB.
#
# This is the size of a *parsed body* — a task, a comment, a board — and it is unrelated to
# ATTACHMENT_MAX_BYTES further down: an upload is multipart/form-data, which this limit never
# sees. The largest single field any endpoint accepts today is 2 KB, so 1 MiB is about two
# orders of magnitude of headroom over anything an honest client sends.
#
# Until this line existed the ceiling was Express's own unconfigured default of 100 kB — a
# number nobody chose and no file recorded (issue #214). Over the limit the API answers 413 with
# the usual JSON error envelope: a client error, and deliberately not reported to error tracking.
#
# Like ATTACHMENT_MAX_BYTES this is a memory ceiling as much as a size one — the body is parsed
# into heap before anything validates it, so N concurrent requests cost up to N × this value.
# Raise it when an endpoint legitimately needs more (importing a board export, for instance),
# and keep it under whatever body size the reverse proxy in front of the API allows.
REQUEST_BODY_MAX_BYTES=1048576
# Dev loop only (`pnpm dev`, docs/development.md#run-modes), where the web app on :3000 and the
# API on :4000 really are separate origins. docker-compose.yml deliberately does NOT read this
# variable: the web image bakes the same-origin path `/api` instead (apps/web/Dockerfile), which
# is correct behind the `proxy` service on every domain and is what makes one published image
# usable by every deployment. Next.js still inlines NEXT_PUBLIC_* at build time — that is a
# property of the framework, not a setting — so an *absolute* value here would still mean a
# per-deployment web build; see apps/web/lib/api-url.ts.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The public origin of a docker-compose.yml deployment — scheme included. This is the one
# value to change to put the stack on your own domain, and nothing is rebuilt when you do.
#
# It configures the `proxy` (Caddy) service that fronts both apps, and the API's WEB_URL /
# BETTER_AUTH_URL are derived from it, so app, API and cookies all agree on one origin.
# `http://localhost` serves plain HTTP for a local install; an `https://` value switches
# Caddy's automatic HTTPS on, which needs the hostname's DNS A/AAAA record pointing at the
# host and ports 80 + 443 reachable from the internet. Compose-only, like TAG below — the dev
# loop uses WEB_URL / BETTER_AUTH_URL above instead. See docs/self-hosting.md.
SITE_URL=http://localhost

# Attachments (docs/decisions/0022-attachment-storage.md,
# docs/decisions/0024-attachment-kinds-and-serving-policy.md). Presence enables, exactly like
# SMTP_HOST below: set STORAGE_PATH and cards accept file uploads; leave it blank and the app
# still boots, `GET /config` reports attachmentsEnabled=false, and the UI hides the upload
# control. There is deliberately no ATTACHMENTS_ENABLED — this file reserves _ENABLED for
# default-on kill switches and for consent. Link attachments work either way: a link needs no
# storage.
#
# docker-compose.yml sets this to /data/attachments inside a named volume and does not read the
# value below; this one is for the dev loop (`pnpm dev`), where an unset value means the feature
# is simply off on your machine. It must be an absolute path.
STORAGE_PATH=
# Largest single upload, in bytes. 26214400 = 25 MiB.
#
# THIS IS THE LIMIT USERS SEE, and the only one to change when you want a different one. It is
# the size of the *file*; the reverse proxy carries a separate, deliberately HIGHER ceiling on
# the whole request body (docker/Caddyfile's `request_body max_size`, or nginx's
# `client_max_body_size` — 26 MiB in both, see docs/self-hosting.md).
#
# The two are not equal and must not be made equal: a multipart upload wraps the file in an
# envelope that adds a few hundred bytes on top of it, so a proxy set to exactly this number
# rejects a file that is exactly this size. They are also not independently tunable in the other
# direction — raise this one above the proxy's ceiling and every upload near the limit fails
# with a 413 the API never sees and never logs. The rule is an ordering: the proxy must stay
# above this value, never at it or below it.
#
# It is also a memory ceiling, not only a disk one: uploads are buffered in memory so the type
# can be read from the magic bytes before anything is written, so N concurrent uploads cost up
# to N × this value of heap.
ATTACHMENT_MAX_BYTES=26214400
# Storage quotas, in bytes (docs/decisions/0027-attachment-quotas.md, updated 2026-08-21). The
# first caps the summed size of one workspace's stored files; the second caps the whole
# instance. Unset or blank = these defaults (2 GiB per workspace, 20 GiB per instance); a
# written 0 = unlimited, the explicit opt-out. Negative is refused at boot. Link attachments
# store no bytes and never count.
#
# WHY THERE ARE DEFAULTS: STORAGE_PATH in the published Compose stack shares its disk with
# Postgres, so an unbounded instance that fills up takes the database down with it, and the
# operator who never reads this comment is exactly the one that would happen to. Set the
# instance quota below your volume's real headroom; the quotas are soft (simultaneous uploads
# can each overshoot by at most one file), so budget the quota plus a few × ATTACHMENT_MAX_BYTES
# of slack. The API logs the effective numbers, and which of them are defaults, at boot.
#
# UPGRADING: a workspace already holding more than 2 GiB gets a 413 on its next upload unless
# you set a higher number or 0 first. `SELECT SUM(size) FROM "Attachment" WHERE kind = 'FILE'`
# is the instance's current usage (docs/self-hosting.md has the per-workspace version).
#
# Rejections are a 413 whose JSON body carries error: "Attachment Quota Exceeded" — same status
# as the per-file limit, told apart by that field.
ATTACHMENT_WORKSPACE_QUOTA_BYTES=2147483648
ATTACHMENT_INSTANCE_QUOTA_BYTES=21474836480
# Upload byte budget per client IP per minute, in bytes. 268435456 = 256 MiB, about ten
# max-size uploads. Unset or blank = this default; 0 = off; negative is refused at boot.
#
# The per-route request throttle (20 uploads a minute) counts requests, which is the wrong unit
# for disk: twenty 25 MiB uploads and twenty 10 kB uploads spend the same allowance. This one
# counts bytes, charged from the request's Content-Length before the body is read (a multipart
# request without one is charged ATTACHMENT_MAX_BYTES). It is keyed by the same client IP as
# the other limits, so TRUST_PROXY matters here too, and it honours RATE_LIMIT_ENABLED. Counters
# live in Redis when REDIS_URL is set and fall back to process memory when Redis errors.
#
# Rejections are a 429 whose JSON body carries error: "Upload Budget Exceeded" plus a
# Retry-After header: same status as the request throttle, told apart by that field.
ATTACHMENT_UPLOAD_BYTES_PER_MINUTE=268435456
# Largest Trello board export the importer will accept, in bytes. 20971520 = 20 MiB.
#
# Separate from ATTACHMENT_MAX_BYTES on purpose: that one is a disk ceiling, this one is a memory
# ceiling. The body is buffered and then parsed, and the parsed object graph is several times the
# size of the bytes that produced it — so raising this raises heap use by a multiple, not by the
# difference. It is also separate from REQUEST_BODY_MAX_BYTES, which governs JSON bodies and
# never sees a multipart upload.
#
# It must stay below the reverse proxy's request body limit (`docker/Caddyfile`'s `request_body
# max_size`, 26 MiB) with room for the multipart envelope; `two-layer-limit.spec.ts` enforces
# that and fails the build if it stops being true.
#
# Importing needs no STORAGE_PATH: an import creates link attachments, which store no bytes, so
# the feature works on an instance with attachments switched off entirely.
TRELLO_IMPORT_MAX_BYTES=20971520

# SMTP for outbound email: invitation-acceptance verification links (see
# docs/decisions/0013-invitation-email-verification.md) and notification email (assignment,
# mention, due-soon; each user can switch it off). All optional as a group: leave SMTP_HOST
# unset and the mail module falls back to logging the message instead of sending it, so the
# app still boots with no mail provider configured — but no invitation can be accepted and no
# notification email goes out while that's true. For local dev, point these at the Mailpit container started by
# docker-compose.dev.yml (see docs/development.md#smtp-and-mailpit).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS, or plaintext against Mailpit).
SMTP_SECURE=false
MAIL_FROM=Kurul <noreply@example.com>

# Data retention (docs/decisions/0020-data-retention.md). A nightly BullMQ job deletes rows
# the policy no longer allows the database to hold: expired Session and Verification rows
# (their own expiresAt decides, nothing to configure here), read notifications, old activity,
# and finished invitations. It needs REDIS_URL like the due-soon worker does.
#
# CLEANUP_ENABLED=false switches the whole sweep off — the app keeps working, but the
# instance stops enforcing its own retention policy, including on the IP addresses, user
# agents and e-mail addresses that sit in expired auth rows.
CLEANUP_ENABLED=true
# Days a notification is kept AFTER the user read it. Unread notifications are never
# deleted, at any age. 0 = keep forever.
NOTIFICATION_RETENTION_DAYS=90
# Days an activity row is kept after it was written. The dashboard only ever reads the last
# 14 days, but the activity feed is a history users browse — see the ADR for why this is a
# year and not a fortnight. 0 = keep forever (set this if you have an audit-trail duty).
# This window also governs UsagePing — the deduplicated "somebody opened a board / the
# dashboard" rows behind the activation funnel below. Same class of row (instance history
# naming a user), so one setting rather than two that can silently disagree.
ACTIVITY_RETENTION_DAYS=365
# Days a FINISHED invitation is kept, measured from when it was created. Finished means
# somebody answered it (accepted, rejected, canceled) or its expiry has passed; a pending,
# unexpired invitation is never deleted, however old the row is. This is the only table in
# the sweep holding the personal data of somebody who is not a user here — an invitation sent
# to an address that never signed up leaves no account for anyone to delete — so keeping it
# forever means keeping a third party's e-mail address forever. 0 = keep forever.
INVITATION_RETENTION_DAYS=90

# Activation funnel and telemetry (docs/decisions/0021-activation-funnel-and-opt-in-telemetry.md).
# Two separate things, and the difference is the point.
#
# 1. The funnel itself is computed from rows this instance already holds and is shown only to
#    you. Nothing about it is ever sent anywhere. Who "you" is, is this list: comma-separated
#    addresses of the accounts allowed to read instance-wide numbers. BLANK — the default —
#    MEANS NOBODY, including the account that owns every workspace on the box. There is
#    deliberately no in-app way to grant this and no workspace role that implies it: on an
#    install with open registration, "owner of a workspace" is a role any visitor can hand
#    themselves by creating one. Matched case-insensitively; a restart applies a change.
#
#    This list now grants a second thing, and it is not read-only: executing a GDPR/KVKK
#    erasure request on somebody else's account (DELETE /instance/users/:userId,
#    docs/decisions/0026-account-deletion-anonymisation.md). That is deliberate — such a request
#    usually reaches an operator by email, from a person who has already lost access to the
#    account — but it means writing an address here hands out a destructive capability, not just
#    a dashboard. Blank still means nobody.
#
#    A listed address only grants either capability once that account's own email is verified.
#    Kurul does not require email verification to sign in, and a deleted account's address is
#    freed for reuse — so listing an address here does not, by itself, protect it: whoever
#    proves ownership of the mailbox first is the one this list admits.
INSTANCE_ADMIN_EMAILS=
# 2. Outbound telemetry. OFF, and it stays off unless you switch it on — Kurul is
#    self-hosted software and does not phone home. With this false (the default), no outbound
#    request is made at all. Turning it on sends ONE POST when the API process starts,
#    carrying exactly this and nothing else:
#
#      {"event": "instance_started", "version": "0.1.0"}
#
#    No instance identifier, no hostname, no IP, no URL, no counts of anything, no part of the
#    activation funnel, nothing about any person. No retry, no queue, no schedule. The payload
#    is logged in full before it is sent, so you can read what left your server in your own
#    API log. docs/development.md#activation-funnel-and-telemetry lists the fields line by line.
TELEMETRY_ENABLED=false
# Where that ping goes. NO DEFAULT, on purpose: a hard-coded third-party address in a codebase
# self-hosters are asked to audit is exactly the thing to avoid, and Dravcore publishes no
# collector today. TELEMETRY_ENABLED=true with this blank logs an error and sends nothing —
# which also makes "point it at my own collector" a supported use rather than a workaround.
TELEMETRY_ENDPOINT=
# How long that single request may take before it is abandoned. `fetch` without a deadline
# waits on the OS TCP timeout, and this runs during boot — a collector that accepts the
# connection and then says nothing would otherwise hold a pending request for minutes. Any
# failure (refused, DNS, HTTP error, timeout) is one warning line and nothing else.
TELEMETRY_TIMEOUT_MS=5000

# Error tracking (Sentry). Off by default and off unless you fill these in: with the DSNs
# blank, neither app loads the Sentry SDK at all — no initialization, no global handlers, no
# outbound request. Kurul is self-hosted software and does not phone home; turning this on
# is your decision, and pointing it at your own self-hosted Sentry is a supported one.
# What is sent when it is on, and what is scrubbed, is listed in
# docs/development.md#observability. Nothing here enables performance tracing or session
# replay — this is error reporting only.
#
# API side, read at container start (a restart is enough to change it).
SENTRY_DSN=
# The API and web apps are separate Sentry projects with separate DSNs on purpose: the web
# DSN is compiled into the JavaScript every visitor downloads, so it is public by
# construction and belongs to a browser-scoped project. Baked at build time like
# NEXT_PUBLIC_API_URL above — rebuild the web image after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Optional labels on every event. Leave blank and `environment` falls back to NODE_ENV, which
# cannot tell a staging deployment from a production one — set it explicitly if you run both.
# SENTRY_RELEASE is best set to the tag you deployed (e.g. `v0.2.0`); a *wrong* release is
# worse than none, because Sentry reopens issues against it.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# Scheduled backups of the instance — the database and the uploaded attachment files. The
# `backup` sidecar dumps the database and archives the attachments volume every
# BACKUP_INTERVAL seconds into the backup_data volume, keeping the newest BACKUP_KEEP of each
# series; the default pair means a recovery point at most 24h old and a week of history. The
# dev compose file has no backup service. See docs/development.md#upgrading-and-backups.
#
# These two are ALSO read by the API, which is new: the nightly orphan-file sweep will not
# delete a stored file while a dump old enough to disown it is still restorable, and that
# grace period is exactly BACKUP_KEEP × BACKUP_INTERVAL (docs/decisions/0022-attachment-storage.md).
# docker-compose.yml passes the same pair to both services so they cannot disagree. Shortening
# either one shortens the window in which a restore is safe from the sweep — down to a floor of
# 24 hours, which the API applies whatever these two say. The floor is not about backups: bytes
# are written before the row is, so there is always a brief moment when a file no row claims is
# a file that is still being uploaded, and a backup setting must not be able to switch that
# protection off.
BACKUP_INTERVAL=86400
BACKUP_KEEP=7

# Which published GHCR tag `docker compose pull`/`up` resolves for the `api`/`web`/`migrate`
# images (docker-compose.yml: `image: ghcr.io/dravcore/kurul-api:${TAG:-latest}`, same pattern
# for kurul-web and kurul-migrate) — compose-only, and unlike the two variables above no
# application code reads it.
# Blank keeps the default of `latest`, the tag every tagged release also carries
# (.github/workflows/release-images.yml). Set it to a specific release (e.g. `v0.2.0`) to pin
# an install to that version instead of always tracking the newest one, or to roll back — see
# docs/development.md#full-stack-in-docker and docs/development.md#rolling-back-the-application.
TAG=

# Read only by `pnpm db:seed` — no runtime code sees it. Adds a second board ("Load Test
# Board", five columns) carrying this many synthetic tasks alongside the four-task demo board,
# so the board UI can be profiled against something the size of a real one. Blank or 0 (the
# default) skips it entirely; anything that is not a positive integer is treated as blank
# rather than clamped, so a typo cannot quietly seed a board of a different size than the one
# you meant to measure. See docs/development.md#seeding-a-large-board.
SEED_LARGE_BOARD_TASKS=
