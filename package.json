{
  "name": "kurul",
  "private": true,
  "version": "0.3.0",
  "description": "Open-source Kanban-focused project management",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "pnpm -r --parallel --filter @kurul/api --filter @kurul/web dev",
    "build": "pnpm -r --filter @kurul/shared-types --filter @kurul/auth-access --filter @kurul/api --filter @kurul/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --filter @kurul/api --filter @kurul/web --filter @kurul/shared-types --filter @kurul/auth-access test",
    "test:browser": "node e2e/build-stack.mjs && pnpm --filter @kurul/e2e exec playwright test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "pnpm --filter @kurul/shared-types build && pnpm --filter @kurul/auth-access build && pnpm -r typecheck",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema apps/api/prisma/schema.prisma --exit-code",
    "openapi": "pnpm --filter @kurul/api build && pnpm --filter @kurul/api openapi",
    "openapi:check": "pnpm --filter @kurul/api openapi:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{mjs,cjs,js,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.3",
    "prisma": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^5.2.2",
      "deepmerge-ts": "^8.0.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
